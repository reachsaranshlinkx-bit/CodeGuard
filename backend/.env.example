CODEGUARD_APP_NAME=CodeGuard API
CODEGUARD_APP_VERSION=0.1.0
CODEGUARD_ENVIRONMENT=development
CODEGUARD_DEBUG=false
CODEGUARD_LOG_LEVEL=INFO

# Mock AI provider mode is only for local development/testing.
CODEGUARD_AI_PROVIDER=disabled
CODEGUARD_OPENAI_API_KEY=
CODEGUARD_OPENAI_MODEL=
CODEGUARD_OPENAI_REQUEST_TIMEOUT_SECONDS=30

# GitHub API authentication
CODEGUARD_GITHUB_TOKEN=

# CodeGuard API authentication
CODEGUARD_API_KEY=

# GitHub PR review publishing (disabled by default)
CODEGUARD_ENABLE_REVIEW_PUBLISHING=false

# GitHub webhook signature verification
CODEGUARD_GITHUB_WEBHOOK_SECRET=

# Webhook delivery database
CODEGUARD_WEBHOOK_DATABASE_PATH=data/webhook_deliveries.sqlite3
CODEGUARD_WEBHOOK_WORKER_MAX_ATTEMPTS=5
CODEGUARD_WEBHOOK_WORKER_RETRY_DELAY_SECONDS=30